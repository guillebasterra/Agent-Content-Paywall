# Hosted: use a Neon PostgreSQL connection string with sslmode=require.
DATABASE_URL=sqlite:///./.local/tollgate.sqlite
FRONTEND_ORIGIN=http://localhost:8788
PUBLIC_API_URL=http://127.0.0.1:8001
# Generate each 32-byte hex key independently; keep stable across deployments.
RECEIPT_SIGNING_KEY=
WALLET_ENCRYPTION_KEY=
# Recipient address only. The writer seed is not needed by the hosted service.
WRITER_ADDRESS=
# Free XRPL testnet only. Mainnet is deliberately unsupported.
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
