# XRPL (testnet)
XRPL_NETWORK=xrpl:1
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai

# Writer wallet (receives payments) — filled by scripts/create_wallets.py
WRITER_ADDRESS=
WRITER_SEED=

# Buyer agent wallet (pays) — filled by scripts/create_wallets.py
BUYER_ADDRESS=
BUYER_SEED=

# Platform treasury: receives XRPL payments for writers with no address — filled by scripts/create_wallets.py
TREASURY_ADDRESS=
TREASURY_SEED=

# Prices are USD. XRPL invoices convert at this placeholder rate (USD per XRP)
XRP_USD_RATE=2

# Buyer agent limits, in USD
BUYER_BUDGET_USD=5
BUYER_CONFIRM_ABOVE_USD=1
# Old paying buyer MCP only (tag buyer-mcp-xrpl-v1): xrpl or stripe. Switch with `make rail RAIL=stripe`, no restart needed
BUYER_RAIL=xrpl
# The X-Agent-Name the Toll Gate MCP tells Claude to send. Shown on the writer dashboard
BUYER_AGENT_NAME=Claude

# Payments: base (x402 v2, USDC on Base mainnet, to the treasury) or xrpl (XRPL testnet, the fallback)
PAYMENT_RAIL=base
# Coinbase Developer Platform: the treasury wallet and the x402 facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Written by `make treasury`
TREASURY_BASE_ADDRESS=
# Platform share of each read, in basis points (100 = 1%). The writer is credited the rest
PLATFORM_FEE_BPS=0

# Server. TOLLGATE_API_URL must be public https for payments-mcp (`make tunnel` writes it)
TOLLGATE_API_URL=http://localhost:8000
RECEIPT_SIGNING_KEY=
DATABASE_URL=sqlite:///./tollgate.db

# Auth: demo (one placeholder writer, SQLite) or supabase (email codes, Postgres)
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Session pooler string from the dashboard's Connect panel
SUPABASE_DB_URL=

# Stripe, test mode only. Live keys are refused at startup
STRIPE_SECRET_KEY=
# Written by `make stripe-listen`
STRIPE_WEBHOOK_SECRET=
# Written by `make agent`
BUYER_STRIPE_API_KEY=

# Stripe MPP (sandbox test only, not used by the app yet). See docs/MPP.md
# profile_test_... from GET /v2/network/business_profiles/me
STRIPE_PROFILE_ID=
# From GET/POST /v1/crypto/deposit_addresses with network=tempo
TEMPO_DEPOSIT_ADDRESS=
# generatePrivateKey() from viem/accounts. Signs session settlements, holds no funds
MPP_SESSION_OPERATOR_KEY=

# Optional Discord importer (one authorized server text channel).
# Only the local importer needs these; never expose the bot token to agents.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Existing Supabase writer access token, needed only for remote --publish.
TOLLGATE_WRITER_TOKEN=
# Two-bot Discord demo. Existing DISCORD_BOT_TOKEN belongs to Research Bot.
DISCORD_PUBLISHER_BOT_TOKEN=
DISCORD_RESEARCH_BOT_ID=
# Must be the Discord administrator who owns TOLLGATE_WRITER_TOKEN.
DISCORD_PUBLISHER_OWNER_ID=
DISCORD_PRICE_USD=0.01
RESEARCH_PROVIDER=mock
SUMMARY_PROVIDER=manual
# Reserved only: no LLM adapter is enabled yet. Keep credentials local.
LLM_BASE_URL=
LLM_API_KEY=
RESEARCH_MODEL=
SUMMARY_MODEL=

# Discord AMA review website (server-side Next.js settings; register this callback in Discord).
DISCORD_PUBLISHER_APPLICATION_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_REVIEW_CALLBACK_URL=http://localhost:3000/api/discord-review/callback
